{
  // Cloudflare Workers — static site only (no Worker script).
  // Cloudflare builds the repo with `npm run build` and serves ./out.
  "name": "agatstudio",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
